# ===========================
# Xcode
# ===========================

## User-specific settings (window positions, breakpoints, schemes)
xcuserdata/

## Test result bundles (Swift Testing + XCUITest output)
*.xcresult

## Build artifacts
build/
DerivedData/
*.moved-aside

## Obj-C/Swift specific
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## Xcode auto-generated workspace (recreated on open)
*.xcworkspace/xcuserdata/

# ===========================
# Swift Package Manager
# ===========================

## SPM resolves dependencies on build — no need to track them
## This includes firebase-ios-sdk and any future packages
.build/
.swiftpm/
Package.resolved

# ===========================
# Firebase
# ===========================

## Service account keys — NEVER commit these
**/serviceAccountKey*.json
**/firebase-adminsdk*.json

## Firebase debug log
firebase-debug.log
firebase-debug.*.log

## Firebase emulator data
.firebase/
firestore-debug.log
ui-debug.log
pubsub-debug.log
storage-debug.log

## GoogleService-Info.plist contains API keys — keep out of public repos
## Uncomment the line below if your repo is PUBLIC:
**/GoogleService-Info.plist

# ===========================
# Cloud Functions (Node.js)
# ===========================

**/functions/node_modules/
**/functions/.env
**/functions/.env.local

# ===========================
# Node.js (Firebase CLI tooling)
# ===========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# ===========================
# macOS
# ===========================

.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ===========================
# Secrets & Environment
# ===========================

*.p8
*.p12
*.key
*.pem
.env
.env.*

# ===========================
# Claude Code
# ===========================

## Local settings contain machine-specific config — never commit
.claude/settings.local.json

# ===========================
# Misc
# ===========================

## Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## Carthage (won't use, but safe to keep)
Carthage/Build/

## CocoaPods (won't use, but safe to keep)
Pods/